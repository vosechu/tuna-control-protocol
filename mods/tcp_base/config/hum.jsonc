{
  // HUM cable tunables. Consumed by WiringSystem and CableView.
  // cable_max_length_ru — euclidean distance (rack-units) between endpoints
  //   before WiringSystem.handle_connect rejects the link as out-of-reach.
  // cable_sag_factor    — per-1000 multiplier applied to catenary sag when
  //   rendering; higher = more droop. Used by CableView, not the sim.
  "schema_version": 1,
  "cable_max_length_ru": 20,
  "cable_sag_factor": 150
}
