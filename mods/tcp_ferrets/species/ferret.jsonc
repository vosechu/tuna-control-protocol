{
  // Ferret species definition — derived from game_server.gd hardcoded values
  // Slinky: warmth 300, comfort 600, curiosity 900
  // Bandit: warmth 400, comfort 800, curiosity 800
  "schema_version": 1,
  "id": "tcp_ferrets:ferret",
  "name": "Ferret",
  "desires": {
    "warmth": 350,
    "comfort": 700,
    "curiosity": 850,
    "hunger": 700,
    "attention": 400
  },
  "personality_ranges": {
    "warmth": [300, 400],
    "comfort": [600, 800],
    "curiosity": [800, 900],
    "hunger": [600, 800],
    "attention": [300, 500]
  },
  "physical": { "mass": 1500, "size_ru": 1 },
  "strength": 1500,
  "traversal": ["WALK", "JUMP_UP", "JUMP_DOWN"],
  "max_jump_height_ru": 2,
  "variants": ["lilotter"],
  "ambient_states": {
    "warm": [
      { "state": "IDLE",       "weight": 10 },
      { "state": "SNIFFING",   "weight": 20 },
      { "state": "SPEED_BUMP", "weight": 10 },
      { "state": "SLEEPING",   "weight": 15 }
    ],
    "cold": [
      { "state": "IDLE",       "weight": 10 },
      { "state": "SNIFFING",   "weight": 20 },
      { "state": "SPEED_BUMP", "weight": 10 }
    ]
  },
  "sprite_config": {
    "base_path": "res://mods/tcp_ferrets/sprites/{variant}",
    "offset_y": -8,
    "animations": {
      "IDLE":       { "animation": "idle" },
      "SEEKING":    { "animation": "walk" },
      "MOVING_TO":  { "animation": "walk" },
      "WANDERING":  { "animation": "walk" },
      "LOAFING":    { "animation": "sit" },
      "SETTLING":   { "animation": "sit" },
      "SLEEPING":   { "animation": "sleep" },
      "SNIFFING":   { "animation": "sneak" },
      "SPEED_BUMP": { "animation": "liedown" }
    },
    "animation_frames": {
      "idle":    { "sprite": "_idle_strip8.png",    "frames": 8, "fps": 6.0 },
      "walk":    { "sprite": "_walk_strip8.png",    "frames": 8, "fps": 8.0 },
      "sit":     { "sprite": "_sit_strip8.png",     "frames": 8, "fps": 4.0 },
      "sleep":   { "sprite": "_sleep_strip4.png",   "frames": 4, "fps": 2.0 },
      "sneak":   { "sprite": "_sneak_strip4.png",   "frames": 4, "fps": 6.0 },
      "liedown": { "sprite": "_liedown_strip8.png", "frames": 8, "fps": 4.0 }
    }
  },
  "states": {
    "idle": { "advertisements": [] },
    "sleeping": {
      "advertisements": [
        { "desire_type": "warmth", "strength": 200, "radius_ru": 1 }
      ]
    },
    "seeking": { "advertisements": [] },
    "startled": { "advertisements": [] }
  },
  "sounds": {
    "dook": ["ferret_dook_01.wav"],
    "startled": ["ferret_startled_01.wav"]
  },
  "verbs": {
    "push": { "effectiveness": 800, "desire_affinities": { "curiosity": 500 } },
    "drag": { "effectiveness": 1000, "desire_affinities": { "curiosity": 900 } }
  },
  "hud_color": [0.6, 0.9, 0.7],
  "initial_state": "idle",
  "starters": [
    { "name": "Slinky", "rack": 1 },
    { "name": "Bandit", "rack": 2 }
  ]
}
