{
  // Tuna can object — derived from object_state_manager.gd OBJECT_CONFIG
  "schema_version": 3,
  "id": "tcp_tuna:tuna_can",
  "name": "Tuna Can",
  "states": {
    "sealed": {
      "advertisements": [
        { "channel": "openable", "strength": 800, "effect_radius_px": 24, "action": "open" }
      ],
      "sprite": "tuna_can_sealed.png",
      "transitions": {
        "open": { "trigger": "robot_arm_action" }
      }
    },
    "open": {
      "advertisements": [
        { "channel": "food", "strength": 800, "effect_radius_px": 40, "action": "eat" }
      ],
      "sprite": "tuna_can_open.png",
      "transitions": {
        "empty": { "trigger": "consumed", "after_ticks": 600 }
      }
    },
    "empty": {
      "advertisements": [],
      "sprite": "tuna_can_empty.png"
    }
  },
  "initial_state": "sealed",
  "physical": { "mass": 400, "size_ru": 1 }
}
