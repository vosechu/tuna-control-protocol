{
  "schema_version": 4,
  "id": "tcp_test_species:test_creature",
  "name": "TestCreature",
  "desires": {
    "warmth":  { "weight": 500, "decay": -2 },
    "comfort": { "weight": 500, "decay": -3 }
  },
  "senses": { "sight": 186, "hearing": 186, "smell": 186, "touch": 32 },
  "body_capabilities": { "walks": { "speed_px_per_tick": 2 } },
  "body_geometry": { "size_ru": 1 },
  "variants": ["cat01"],
  "hud_color": [0.5, 0.5, 0.5],
  "sprite_config": {
    "base_path": "res://mods/tcp_cats/sprites/{variant}",
    "offset_y": -12,
    "animations": {
      "IDLE":    { "animation": "idle" },
      "SEEKING": { "animation": "walk" }
    },
    "animation_frames": {
      "idle": { "sprite": "_idle_strip8.png", "frames": 8, "fps": 6.0 },
      "walk": { "sprite": "_walk_strip8.png", "frames": 8, "fps": 8.0 }
    }
  },
  "ambient_states": {
    "warm": [ { "state": "IDLE", "weight": 10, "min_duration_ticks": 30 } ],
    "cold": [ { "state": "IDLE", "weight": 10, "min_duration_ticks": 30 } ]
  },
  "special_states": { "STARTLED": { "min_duration_ticks": 10 } },
  "states": { "idle": { "advertisements": [] } },
  "initial_state": "idle"
}
