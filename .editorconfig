root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.gd]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.jsonc]
indent_style = space
indent_size = 2

[*.tres]
indent_style = space
indent_size = 2

[*.tscn]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cfg]
indent_style = space
indent_size = 4
