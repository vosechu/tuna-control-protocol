{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "script/hooks/post-edit-validate",
            "timeout": 30,
            "statusMessage": "Running script/validate..."
          }
        ]
      }
    ]
  }
}
