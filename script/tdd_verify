#!/usr/bin/env ruby
# tdd_verify — process-gated TDD verification with audit trail.
#
# Enforces the per-test red-green-mutation-restore cycle described in
# .claude/rules/llm-test-verification.md. The script owns the test runs
# and records the evidence; the agent cannot fabricate compliance.
#
# Subcommands:
#   start <test_file>    — baseline green, lock session
#   mutation <test_name> — verify exactly <test_name> fails; record evidence
#   restore <test_name>  — verify production reverted and tests green
#   finish               — verify every test cycled, write .gd.stamp + audit
#   abort                — drop the session state (no artifacts written)
#
# Session state lives in .tdd-state.yaml (git-ignored). Audit evidence is
# written to <test_file>.gd.audit.yaml alongside the stamp on finish.

require 'digest'
require 'fileutils'
require 'open3'
require 'pathname'
require 'time'
require 'yaml'

REPO_ROOT  = `git rev-parse --show-toplevel`.strip
STATE_FILE = File.join(REPO_ROOT, '.tdd-state.yaml')
GUT_SCRIPT = File.join(REPO_ROOT, 'script/checks/gut_tests')

def die(msg)
  warn "tdd_verify: #{msg}"
  exit 1
end

def sha8(str)
  Digest::SHA256.hexdigest(str)[0, 8]
end

def load_state
  die 'no TDD session in progress (run: tdd_verify start <test_file>)' unless File.exist?(STATE_FILE)
  YAML.load_file(STATE_FILE)
end

def save_state(state)
  File.write(STATE_FILE, YAML.dump(state))
end

def list_test_functions(path)
  File.read(path).scan(/^func (test_\w+)/).flatten
end

# Split a GDScript test file into logical function/top-level units, preserving
# order. Returns an Array of Hashes: {kind: :func|:var, name: String, body: String}.
# `body` excludes lines starting with `# AI-DEV:` so annotations can be added
# without invalidating the per-test hash.
def parse_units(path)
  lines = File.readlines(path)
  units = []
  current = nil

  lines.each do |line|
    if line =~ /^func\s+(\w+)\s*\(/
      units << current if current
      current = { kind: :func, name: Regexp.last_match(1), body: line }
      next
    end
    if line =~ /^(?:class|var|const|signal|enum)\s/
      # Top-level declarations break the current function body.
      units << current if current
      current = nil
      units << { kind: :top, name: line.strip, body: line } if line.start_with?('var ')
      next
    end
    if current
      current[:body] += line
    end
  end
  units << current if current
  units
end

def stamp_body_for(units, name)
  unit = units.find { |u| u[:kind] == :func && u[:name] == name }
  return '' unless unit

  # Strip AI-DEV markers and trailing whitespace to match the bash tooling's
  # hash stability guarantees.
  unit[:body].each_line.reject { |l| l.include?('# AI-DEV:') }
             .map { |l| l.rstrip }
             .join("\n")
end

def setup_body(units, test_names)
  parts = units.reject { |u| u[:kind] == :func && test_names.include?(u[:name]) }
  parts.map { |u|
    u[:body].each_line.reject { |l| l.include?('# AI-DEV:') }
            .map { |l| l.rstrip }
            .join("\n")
  }.join
end

def write_stamp(test_file_abs, test_names)
  units = parse_units(test_file_abs)
  stamp_path = "#{test_file_abs}.stamp"
  header = <<~YAML_HEADER
    # AI-DEV: AI **MUST NOT** edit this file. It is generated by script/tdd_verify.
    # If a stamp is invalid, re-run the full verification process — do not
    # manually update hashes.
  YAML_HEADER
  body = {
    'setup_hash' => sha8(setup_body(units, test_names)),
    'verified_at' => Time.now.utc.iso8601,
    'tests' => test_names.each_with_object({}) { |n, h| h[n] = sha8(stamp_body_for(units, n)) }
  }
  File.write(stamp_path, header + YAML.dump(body))
  stamp_path
end

def run_gut
  out, status = Open3.capture2e(GUT_SCRIPT)
  { output: out, exit: status.exitstatus }
end

def strip_ansi(str)
  str.gsub(/\e\[[0-9;]*m/, '')
end

def parse_failing_tests(gut_output)
  clean = strip_ansi(gut_output)
  failing = []
  in_summary = false
  clean.each_line do |line|
    if line =~ /^\s*Failing tests:/
      in_summary = true
      next
    end
    next unless in_summary

    # Format emitted by script/checks/gut_tests failure_summary:
    #   "  tests/path.gd:LINE  test_name"
    failing << Regexp.last_match(1) if line =~ /^\s+\S+\.gd:\d+\s+(test_\w+)/
  end
  failing.uniq
end

# Combined hash of production source (non-test, non-generated). Used as the
# "baseline" snapshot at start and compared on every subsequent command to
# detect mutation presence and to verify restoration.
def prod_tree_hash
  patterns = %w[*.gd *.jsonc *.json *.gdshader *.tscn *.tres]
  files = []
  patterns.each do |pat|
    files += Dir.glob(File.join(REPO_ROOT, '**', pat))
  end
  files.reject! do |f|
    f.include?('/tests/') ||
      f.include?('/.godot/') ||
      f.include?('/addons/') ||
      File.basename(f).start_with?('.')
  end
  files.uniq!
  files.sort!
  combined = files.map do |f|
    rel = f.sub("#{REPO_ROOT}/", '')
    "#{rel}\0#{File.read(f)}\0"
  end.join
  sha8(combined)
end

def require_session_integrity(state)
  abs = File.expand_path(state['test_file'], REPO_ROOT)
  die "test file gone: #{state['test_file']} — aborting session" unless File.exist?(abs)
  return unless sha8(File.read(abs)) != state['test_file_hash']

  die 'test file hash changed mid-session — test edits must happen outside TDD cycle'
end

# ---- commands ----

def cmd_start(test_file)
  die 'session already in progress; run `tdd_verify finish` or `tdd_verify abort` first' if File.exist?(STATE_FILE)

  abs = File.expand_path(test_file, REPO_ROOT)
  die "test file not found: #{test_file}" unless File.exist?(abs)

  rel = Pathname.new(abs).relative_path_from(Pathname.new(REPO_ROOT)).to_s

  puts 'tdd_verify: running baseline tests...'
  result = run_gut
  if result[:exit] != 0
    warn result[:output]
    die 'baseline tests failed; fix before starting TDD session'
  end

  tests = list_test_functions(abs)
  die "no test_ functions found in #{rel}" if tests.empty?

  state = {
    'test_file' => rel,
    'test_file_hash' => sha8(File.read(abs)),
    'baseline_tree_hash' => prod_tree_hash,
    'baseline_output_hash' => sha8(result[:output]),
    'started_at' => Time.now.utc.iso8601,
    'expected_tests' => tests,
    'tests' => {}
  }
  save_state(state)

  puts "tdd_verify: session started for #{rel}"
  puts "tdd_verify: #{tests.size} test(s) to verify:"
  tests.each { |t| puts "  - #{t}" }
  puts 'tdd_verify: mutate production for the FIRST test, then:'
  puts "  script/tdd_verify mutation #{tests.first}"
end

def cmd_mutation(test_name)
  state = load_state
  require_session_integrity(state)

  die "test '#{test_name}' not in expected_tests list" unless state['expected_tests'].include?(test_name)

  existing = state['tests'][test_name]
  die "test '#{test_name}' already has a mutation entry" if existing && existing['mutation_at']

  current_tree = prod_tree_hash
  die 'production tree unchanged — did you mutate the implementation?' if current_tree == state['baseline_tree_hash']

  # Duplicate mutation detection: same post-mutation tree used for a prior test.
  state['tests'].each do |prev_name, prev|
    next unless prev['mutation_tree_hash']

    if prev['mutation_tree_hash'] == current_tree
      die "mutation tree matches prior mutation for '#{prev_name}' — use a different mutation"
    end
  end

  puts 'tdd_verify: running tests with mutation applied...'
  result = run_gut
  die 'mutation did not break any tests — pick a more targeted mutation' if result[:exit].zero?

  failing = parse_failing_tests(result[:output])
  unless failing == [test_name]
    warn result[:output]
    die "expected exactly [#{test_name}] to fail, got: #{failing.inspect}\nuse a more surgical mutation"
  end

  output_hash = sha8(result[:output])
  state['tests'].each do |prev_name, prev|
    die "mutation output matches prior mutation for '#{prev_name}'" if prev['mutation_output_hash'] == output_hash
  end

  state['tests'][test_name] ||= {}
  state['tests'][test_name].merge!(
    'mutation_at' => Time.now.utc.iso8601,
    'mutation_tree_hash' => current_tree,
    'mutation_output_hash' => output_hash
  )
  save_state(state)

  puts "tdd_verify: mutation confirmed for '#{test_name}'"
  puts "  mutation_tree_hash:   #{current_tree}"
  puts "  mutation_output_hash: #{output_hash}"
  puts 'tdd_verify: restore the production code, then:'
  puts "  script/tdd_verify restore #{test_name}"
end

def cmd_restore(test_name)
  state = load_state
  require_session_integrity(state)

  entry = state['tests'][test_name]
  die "no mutation recorded for '#{test_name}' — run mutation first" unless entry && entry['mutation_at']
  die "'#{test_name}' already restored" if entry['restored_at']

  current_tree = prod_tree_hash
  if current_tree != state['baseline_tree_hash']
    die 'production tree does not match baseline — revert the mutation completely'
  end

  puts 'tdd_verify: running tests after restore...'
  result = run_gut
  if result[:exit] != 0
    warn result[:output]
    die 'tests still failing after restore'
  end

  entry['restored_at'] = Time.now.utc.iso8601
  save_state(state)

  remaining = state['expected_tests'].reject do |t|
    e = state['tests'][t]
    e && e['restored_at']
  end

  puts "tdd_verify: '#{test_name}' restored and green"
  if remaining.empty?
    puts 'tdd_verify: all tests cycled — run `script/tdd_verify finish` to stamp'
  else
    puts "tdd_verify: next test: mutate for '#{remaining.first}', then:"
    puts "  script/tdd_verify mutation #{remaining.first}"
  end
end

def cmd_finish
  state = load_state
  require_session_integrity(state)

  incomplete = state['expected_tests'].reject do |t|
    e = state['tests'][t]
    e && e['mutation_at'] && e['restored_at']
  end
  die "tests missing full cycle: #{incomplete.join(', ')}" unless incomplete.empty?

  # Tripwire: every mutation_tree_hash and mutation_output_hash must be unique.
  {
    'mutation_tree_hash' => 'tree',
    'mutation_output_hash' => 'output'
  }.each do |key, label|
    seen = {}
    state['tests'].each do |name, entry|
      h = entry[key]
      next unless h

      die "duplicate mutation #{label} hash between '#{seen[h]}' and '#{name}'" if seen[h]
      seen[h] = name
    end
  end

  if prod_tree_hash != state['baseline_tree_hash']
    die 'production tree differs from baseline at finish — revert or commit mutations before finishing'
  end

  puts 'tdd_verify: running final green check...'
  result = run_gut
  if result[:exit] != 0
    warn result[:output]
    die 'final tests failing'
  end

  abs = File.expand_path(state['test_file'], REPO_ROOT)
  stamp_path = write_stamp(abs, state['expected_tests'])
  puts "tdd_verify: stamp written to #{stamp_path}"

  audit = {
    'test_file' => state['test_file'],
    'test_file_hash' => state['test_file_hash'],
    'baseline_tree_hash' => state['baseline_tree_hash'],
    'started_at' => state['started_at'],
    'finished_at' => Time.now.utc.iso8601,
    'tests' => state['tests']
  }
  audit_path = "#{abs}.audit.yaml"
  File.write(audit_path, "# Generated by script/tdd_verify. Commit alongside the .stamp file.\n#{YAML.dump(audit)}")
  puts "tdd_verify: audit written to #{audit_path}"

  File.delete(STATE_FILE)
  puts 'tdd_verify: session complete. stamp + audit ready to commit.'
end

def cmd_abort
  if File.exist?(STATE_FILE)
    File.delete(STATE_FILE)
    puts 'tdd_verify: session aborted, state discarded'
  else
    puts 'tdd_verify: no session to abort'
  end
end

# ---- dispatch ----

cmd = ARGV.shift

case cmd
when 'start'
  die 'usage: tdd_verify start <test_file>' unless ARGV.length == 1
  cmd_start(ARGV[0])
when 'mutation'
  die 'usage: tdd_verify mutation <test_name>' unless ARGV.length == 1
  cmd_mutation(ARGV[0])
when 'restore'
  die 'usage: tdd_verify restore <test_name>' unless ARGV.length == 1
  cmd_restore(ARGV[0])
when 'finish'
  die 'usage: tdd_verify finish' unless ARGV.empty?
  cmd_finish
when 'abort'
  cmd_abort
else
  warn 'usage: tdd_verify {start|mutation|restore|finish|abort} [args]'
  exit 1
end
