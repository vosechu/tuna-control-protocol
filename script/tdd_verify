#!/usr/bin/env ruby
# tdd_verify — hash-based tamper-evidence for test files.
#
# Writes a `.gd.stamp` sidecar alongside a test file that pins the hash
# of the file's setup block and of each test function body. If any of
# those change without re-stamping, `script/checks/verify_tests` fails
# the build.
#
# This tool used to drive a per-test mutation cycle (red-green-mutate-
# restore) to prove each test depends on production code. That cycle
# was removed once the /spec-first skill moved mutation design up
# front: feature plans list each test's bug hypothesis alongside its
# description, and production implementations run in information-
# hidden subagents (see /spec-first Phase 5). Those mechanisms cover
# the "does this test actually test anything" guarantee with fewer
# gaming side-effects than stamp-time mutation puzzles.
#
# What remains: tamper-evidence. Silent edits to test bodies still
# need to be caught, and the hash sidecar still does that.
#
# Subcommands:
#   stamp <test_file>            — run tests, confirm green, write stamp
#   restamp <test_file> <reason> — re-stamp after cosmetic change;
#                                  echoes the reason to stdout so it
#                                  ends up in the commit message
#
# Stamping is scoped to tests/unit/ only — see script/checks/verify_tests.
# Integration, scenario, scene, soak, and perf suites are not stamped.

require 'digest'
require 'open3'
require 'pathname'
require 'time'
require 'yaml'

require_relative 'lib/test_stamp'

REPO_ROOT  = `git rev-parse --show-toplevel`.strip
GUT_SCRIPT = File.join(REPO_ROOT, 'script/checks/gut_tests')

def die(msg)
  warn "tdd_verify: #{msg}"
  exit 1
end

def list_test_functions(path)
  File.read(path).scan(/^func (test_\w+)/).flatten
end

def write_stamp(test_file_abs, test_names)
  units = TestStamp.parse_units(test_file_abs)
  stamp_path = "#{test_file_abs}.stamp"
  header = <<~YAML_HEADER
    # AI-DEV: AI **MUST NOT** edit this file. It is generated by script/tdd_verify.
    # If a stamp is invalid, re-run `script/tdd_verify stamp <file>` — do not
    # manually update hashes.
  YAML_HEADER
  body = {
    'setup_hash' => TestStamp.hash_setup(units, test_names),
    'verified_at' => Time.now.utc.iso8601,
    'tests' => test_names.each_with_object({}) { |n, h| h[n] = TestStamp.hash_test(units, n) }
  }
  File.write(stamp_path, header + YAML.dump(body))
  stamp_path
end

def resolve_test_file(test_file)
  abs = File.expand_path(test_file, REPO_ROOT)
  die "test file not found: #{test_file}" unless File.exist?(abs)
  rel = Pathname.new(abs).relative_path_from(Pathname.new(REPO_ROOT)).to_s
  die "#{rel} is outside tests/unit/; stamping is scoped to unit tests only" unless rel.start_with?('tests/unit/')
  [abs, rel]
end

def run_file_tests(rel)
  out, status = Open3.capture2e(GUT_SCRIPT, '-f', rel)
  { output: out, exit: status.exitstatus }
end

def cmd_stamp(test_file)
  abs, rel = resolve_test_file(test_file)

  test_names = list_test_functions(abs)
  die "no test_ functions found in #{rel}" if test_names.empty?

  puts "tdd_verify: running tests in #{rel}..."
  result = run_file_tests(rel)
  if result[:exit] != 0
    warn result[:output]
    die 'tests failing — fix before stamping'
  end

  stamp_path = write_stamp(abs, test_names)
  puts "tdd_verify: stamped #{stamp_path}"
  puts "tdd_verify: #{test_names.size} test(s) pinned"
end

def cmd_restamp(test_file, reason)
  abs, rel = resolve_test_file(test_file)

  if reason.nil? || reason.strip.empty?
    die 'refusing to re-stamp without a reason; pass a short one-sentence explanation'
  end
  trimmed = reason.strip
  if trimmed.length < 20
    die "reason too short (#{trimmed.length} chars); explain the cosmetic change and which exception applies"
  end

  puts "tdd_verify: running tests in #{rel} before re-stamp..."
  result = run_file_tests(rel)
  if result[:exit] != 0
    warn result[:output]
    die 'tests failing; re-stamp is only for cosmetic changes to already-passing tests'
  end

  test_names = list_test_functions(abs)
  die "no test_ functions found in #{test_file}" if test_names.empty?

  stamp_path = write_stamp(abs, test_names)

  puts "tdd_verify: restamped #{stamp_path}"
  puts "tdd_verify: reason: #{trimmed}"
  puts 'tdd_verify: reminder — restamp is for cosmetic-only changes:'
  puts '  * lint-forced whitespace/wrapping'
  puts '  * comment edits that do not change assertion logic'
  puts '  * renames of unused variables/helpers the tests do not reference'
  puts 'Any change to assertions, expected values, setup data, or branch logic'
  puts 'needs a full red-green-commit cycle (see /verify-test skill), not a restamp.'
end

# ---- dispatch ----

cmd = ARGV.shift

case cmd
when 'stamp'
  die 'usage: tdd_verify stamp <test_file>' unless ARGV.length == 1

  cmd_stamp(ARGV[0])
when 'restamp'
  die "usage: tdd_verify restamp <test_file> '<reason>'" unless ARGV.length == 2

  cmd_restamp(ARGV[0], ARGV[1])
else
  warn 'usage: tdd_verify {stamp|restamp} [args]'
  warn ''
  warn 'stamp    — write a stamp sidecar that pins test file hashes.'
  warn '           Run after writing or modifying a test (red-green-commit).'
  warn 'restamp  — re-stamp after a cosmetic-only edit (whitespace, comments).'
  warn ''
  warn 'The per-test mutation cycle was removed. Bug hypotheses in the plan'
  warn 'doc (/spec-first) and information-hidden implementation agents cover'
  warn 'the "does this test actually test something" guarantee with less'
  warn 'gaming surface than stamp-time mutation puzzles.'
  exit 1
end
