#!/bin/bash
# Generates tamper-evident .gd.stamp sidecar files for test files.
# This is the WRITE operation — it computes hashes and writes the stamp.
# It does NOT run tests or verify anything. The verification process
# is defined in .claude/rules/llm-test-verification.md.
#
# Usage: stamp_tests <test_file.gd> [test_file2.gd ...]
#        stamp_tests --all          (stamp all test files)

set -uo pipefail
# Note: NOT using set -e because grep returns non-zero on no-match,
# which is expected when parsing GDScript files.

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

# ── Helpers ──────────────────────────────────────────────────────────────────

# Extract test function names from a GDScript test file
get_test_functions() {
    local file="$1"
    grep -n '^func test_' "$file" | sed 's/(.*//' | sed 's/^.*func //'
}

# Extract the body of a single test function (everything between func lines)
# Excludes the AI-DEV marker line from the hash so the marker can be
# added/updated without invalidating the hash.
get_function_body() {
    local file="$1"
    local func_name="$2"

    # Find the line number of this function
    local start_line
    start_line=$(grep -n "^func ${func_name}(" "$file" | head -1 | cut -d: -f1)

    if [ -z "$start_line" ]; then
        echo ""
        return
    fi

    # Find the next func line or end of file
    local total_lines
    total_lines=$(wc -l < "$file")

    local end_line
    end_line=$(tail -n +"$((start_line + 1))" "$file" | grep -n '^func \|^class \|^var \|^const \|^signal \|^enum \|^# ──' | head -1 | cut -d: -f1)

    if [ -z "$end_line" ]; then
        end_line=$((total_lines - start_line + 1))
    else
        end_line=$((end_line - 1))
    fi

    # Extract the body, strip AI-DEV lines, strip leading/trailing whitespace
    sed -n "${start_line},$((start_line + end_line - 1))p" "$file" \
        | grep -v '# AI-DEV:' \
        | sed 's/[[:space:]]*$//'
}

# Compute SHA256 hash of a string, output first 8 hex chars
hash_string() {
    echo -n "$1" | shasum -a 256 | cut -c1-8
}

# Compute SHA256 hash of a file, output first 8 hex chars
hash_file() {
    shasum -a 256 "$1" | cut -c1-8
}

# ── Main ─────────────────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    echo "Usage: stamp_tests <test_file.gd> [test_file2.gd ...]" >&2
    echo "       stamp_tests --all" >&2
    exit 1
fi

# Collect files
FILES=()
if [ "$1" = "--all" ]; then
    while IFS= read -r f; do
        FILES+=("$f")
    done < <(find "$REPO_ROOT/tests" -name 'test_*.gd' -not -path '*/.godot/*' | sort)
else
    FILES=("$@")
fi

if [ ${#FILES[@]} -eq 0 ]; then
    echo "No test files found." >&2
    exit 1
fi

STAMPED=0
ERRORS=0

for file in "${FILES[@]}"; do
    if [ ! -f "$file" ]; then
        echo "ERROR: File not found: $file" >&2
        ERRORS=$((ERRORS + 1))
        continue
    fi

    # Get all test functions
    FUNCS=$(get_test_functions "$file")
    if [ -z "$FUNCS" ]; then
        echo "WARNING: No test functions found in $file, skipping" >&2
        continue
    fi

    # Compute file hash
    FILE_HASH=$(hash_file "$file")

    # Compute per-function hashes
    STAMP_FILE="${file}.stamp"
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    {
        echo "# AI-DEV: AI **MUST NOT** edit this file. It is generated by the verification"
        echo "# process defined in .claude/rules/llm-test-verification.md. If a stamp is"
        echo "# invalid, re-run the full verification process — do not manually update hashes."
        echo "file_hash: $FILE_HASH"
        echo "verified_at: $TIMESTAMP"
        echo "tests:"
    } > "$STAMP_FILE"

    while IFS= read -r func_name; do
        BODY=$(get_function_body "$file" "$func_name")
        FUNC_HASH=$(hash_string "$BODY")
        echo "  $func_name: $FUNC_HASH" >> "$STAMP_FILE"
    done <<< "$FUNCS"

    echo "Stamped: $file -> $STAMP_FILE"
    STAMPED=$((STAMPED + 1))
done

echo ""
echo "$STAMPED stamped, $ERRORS errors"

if [ $ERRORS -gt 0 ]; then
    exit 1
fi
exit 0
