#!/bin/bash
# Runs gdlint on GDScript files.
# Usage: gdlint [file ...]    (no args = all *.gd files)

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

if [ $# -eq 0 ]; then
    FILES=$(find "$REPO_ROOT" -name '*.gd' -not -path '*/.godot/*' -not -path '*/addons/*')
else
    FILES="$*"
fi

if [ -z "$FILES" ]; then exit 0; fi

if ! command -v gdlint &> /dev/null; then
    echo "WARNING: gdlint not installed. Skipping. Install: pip install gdtoolkit" >&2
    exit 0
fi

# Batch all files into one gdlint invocation — per-file calls pay ~150ms
# of Python startup each, which turned 122 files into a 21s check.
# shellcheck disable=SC2086
OUTPUT=$(echo "$FILES" | xargs gdlint 2>&1)
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "GDScript lint errors:" >&2
    echo "$OUTPUT" >&2
    exit 1
fi
exit 0
