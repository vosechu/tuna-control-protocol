#!/bin/bash
# Scans for accidentally committed secrets using gitleaks.
# Requires: brew install gitleaks
# Usage: no_secrets              (scan staged + modified + untracked files)
#        no_secrets --all        (scan entire repo tree)
#        no_secrets file1 file2  (scan specific files)
#
# The default skips clean files to keep local validate fast. CI should pass
# --all to catch secrets that slipped into an earlier commit.

if ! command -v gitleaks &> /dev/null; then
    echo "gitleaks not installed. Run: brew install gitleaks" >&2
    exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

scan_files() {
    # $@ = files to scan. Copies each (if it exists) into a temp dir and
    # runs gitleaks once. Returns gitleaks' exit code, or 0 if no real
    # files landed in the temp dir (e.g. all args were deleted paths).
    local tmp rc
    tmp=$(mktemp -d)
    for f in "$@"; do
        if [ -f "$f" ]; then
            cp "$f" "$tmp/" 2>/dev/null
        elif [ -f "$REPO_ROOT/$f" ]; then
            cp "$REPO_ROOT/$f" "$tmp/" 2>/dev/null
        fi
    done
    if [ -z "$(ls -A "$tmp")" ]; then
        rm -rf "$tmp"
        return 0
    fi
    gitleaks dir "$tmp" --no-banner --exit-code 1 2>&1
    rc=$?
    rm -rf "$tmp"
    return $rc
}

case "${1:-}" in
    --all)
        gitleaks dir "$REPO_ROOT" --no-banner --exit-code 1 2>&1
        exit $?
        ;;
    "")
        # Default: staged + modified + untracked (excludes gitignored).
        CHANGED=$(cd "$REPO_ROOT" && {
            git diff --name-only HEAD 2>/dev/null
            git ls-files --others --exclude-standard 2>/dev/null
        } | sort -u)
        if [ -z "$CHANGED" ]; then exit 0; fi
        # shellcheck disable=SC2086
        scan_files $CHANGED
        exit $?
        ;;
    *)
        scan_files "$@"
        exit $?
        ;;
esac
