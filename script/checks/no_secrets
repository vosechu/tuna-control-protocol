#!/bin/bash
# Scans for accidentally committed secrets using gitleaks.
# Requires: brew install gitleaks
# Usage: no_secrets              (scan repo; uses staged files if any are staged)
#        no_secrets file1 file2  (scan specific files)

if ! command -v gitleaks &> /dev/null; then
    echo "gitleaks not installed. Run: brew install gitleaks" >&2
    exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

if [ $# -gt 0 ]; then
    # Scan specific files by creating a temp dir with copies
    TMPDIR=$(mktemp -d)
    trap 'rm -rf "$TMPDIR"' EXIT
    for f in "$@"; do
        if [ -f "$f" ]; then
            cp "$f" "$TMPDIR/"
        elif [ -f "$REPO_ROOT/$f" ]; then
            cp "$REPO_ROOT/$f" "$TMPDIR/"
        fi
    done
    gitleaks dir "$TMPDIR" --no-banner --exit-code 1 2>&1
else
    # Scan the whole repo directory
    gitleaks dir "$REPO_ROOT" --no-banner --exit-code 1 2>&1
fi
