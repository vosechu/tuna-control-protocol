#!/bin/bash
# Ensures no GDScript uses ../ paths to reach up the scene tree.
# Usage: no_parent_paths [file ...]    (no args = all *.gd files)

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

if [ $# -eq 0 ]; then
    FILES=$(find "$REPO_ROOT" -name '*.gd' -not -path '*/.godot/*')
else
    FILES="$*"
fi

if [ -z "$FILES" ]; then exit 0; fi

# Single grep across all files — grep prefixes hits with `file:line:` so
# the output is the same shape as the old per-file loop.
# shellcheck disable=SC2086
MATCHES=$(echo "$FILES" | xargs grep -nE '(get_node[[:space:]]*\([[:space:]]*["'"'"']\.\./)|(NodePath[[:space:]]*\([[:space:]]*["'"'"']\.\.\/)' 2>/dev/null || true)

if [ -n "$MATCHES" ]; then
    echo "BLOCKED: ../ paths found. Children must not reach up the tree." >&2
    echo "$MATCHES" >&2
    exit 1
fi
exit 0
