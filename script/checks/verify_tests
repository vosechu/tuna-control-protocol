#!/usr/bin/env ruby
# Verifies tamper-evident .gd.stamp sidecar files for test files.
# Read-side of the TDD verification system. Run by CI + pre-commit.
#
# Three checks:
#   1. Every test file has a .gd.stamp sidecar
#   2. No orphan .gd.stamp files without a matching test file
#   3. Every stamp's setup_hash and per-test hash matches current content
#
# Share hashing logic with script/tdd_verify via script/lib/test_stamp.rb so
# writer and reader agree by construction.

SCRIPT_DIR = File.expand_path('..', __dir__)
require_relative File.join(SCRIPT_DIR, 'lib/test_stamp')

# Parse a stamp file via regex (not YAML). Hex hashes starting with 0 get
# misinterpreted as octal by Psych, so we pull them out as raw strings.
def parse_stamp(path)
  content = File.read(path)
  setup_match = content[/^setup_hash:\s*(\S+)/, 1]
  tests = {}
  content.each_line do |line|
    next unless line =~ /^\s{2,}(test_\w+):\s*(\S+)/

    tests[Regexp.last_match(1)] = Regexp.last_match(2)
  end
  { 'setup_hash' => setup_match, 'tests' => tests }
end

REPO_ROOT = `git rev-parse --show-toplevel`.strip
TESTS_DIR = File.join(REPO_ROOT, 'tests')

unless Dir.exist?(TESTS_DIR)
  warn "No tests directory at #{TESTS_DIR}"
  exit 1
end

def strip_ansi(str)
  str.gsub(/\e\[[0-9;]*m/, '')
end

test_files = Dir.glob(File.join(TESTS_DIR, '**/test_*.gd')).reject { |f| f.include?('/.godot/') }.sort
stamp_files = Dir.glob(File.join(TESTS_DIR, '**/*.gd.stamp')).reject { |f| f.include?('/.godot/') }.sort

missing_stamps = []
orphan_stamps = []
stale_setup = []
stale_tests = []
missing_tests = []
orphan_tests = []

# Check 1: every test file has a stamp
test_files.each do |tf|
  missing_stamps << tf unless File.exist?("#{tf}.stamp")
end

# Check 2: no orphan stamps
stamp_files.each do |sf|
  orphan_stamps << sf unless File.exist?(sf.sub(/\.stamp\z/, ''))
end

# Check 3: hashes match
test_files.each do |tf|
  stamp_path = "#{tf}.stamp"
  next unless File.exist?(stamp_path)

  stamp = parse_stamp(stamp_path)

  units = TestStamp.parse_units(tf)
  test_names = units.select { |u| u[:kind] == :func && u[:name].start_with?('test_') }.map { |u| u[:name] }

  expected_setup = stamp['setup_hash']
  if expected_setup
    actual_setup = TestStamp.hash_setup(units, test_names)
    # Coerce to String: unquoted numeric-looking hashes in legacy bash
    # stamps parse as Integers via Psych.
    stale_setup << "#{tf} (stamp: #{expected_setup}, actual: #{actual_setup})" if actual_setup.to_s != expected_setup.to_s
  end

  stamp_tests = stamp['tests'] || {}

  test_names.each do |name|
    expected_hash = stamp_tests[name]
    if expected_hash.nil?
      missing_tests << "#{tf}::#{name} (no stamp entry)"
      next
    end
    actual_hash = TestStamp.hash_test(units, name)
    stale_tests << "#{tf}::#{name} (stamp: #{expected_hash}, actual: #{actual_hash})" if actual_hash.to_s != expected_hash.to_s
  end

  stamp_tests.each_key do |stamped_name|
    orphan_tests << "#{tf}::#{stamped_name} (in stamp but not in file)" unless test_names.include?(stamped_name)
  end
end

errors = 0

{
  'Test files with no stamp sidecar (test was never verified):' => missing_stamps,
  'Stamp sidecars with no matching test file:' => orphan_stamps,
  'Test setup modified (before_each/helpers changed — all tests invalidated):' => stale_setup,
  'Individual test functions modified since last verification:' => stale_tests,
  'Test functions added without verification (no stamp entry):' => missing_tests,
  'Removed test functions still present in stamp:' => orphan_tests
}.each do |label, list|
  next if list.empty?

  warn label
  list.each { |f| warn "  #{f}" }
  errors += list.size
end

if errors > 0
  warn ''
  warn "#{errors} verification issue(s) found."
  warn ''
  warn 'These tests are no longer in a verified state. To restore verification'
  warn 'run the full TDD cycle:'
  warn '  script/tdd_verify start <test_file>'
  warn '  # then mutation / restore for each test'
  warn '  script/tdd_verify finish'
  warn ''
  warn 'Cosmetic-only changes (lint-forced whitespace, comment edits) can use:'
  warn "  script/tdd_verify restamp <test_file> '<one-sentence reason>'"
  exit 1
end

exit 0
