#!/bin/bash
# Runs GUT tests. On failure, prints the FULL Godot output so failing test
# names, assertion messages, and file:line locations are visible — the agent
# cannot diagnose failures from a grep'd summary.
#
# Usage:
#   script/checks/gut_tests                    # all test dirs
#   script/checks/gut_tests unit                # only unit tests
#   script/checks/gut_tests -f tests/unit/test_foo.gd   # single file
#   script/checks/gut_tests --failing-only      # only failing test lines
#   script/checks/gut_tests --no-color          # strip ANSI escape codes
#
# Flags can be combined. Positional suite filter (unit/scene/integration/
# scenario) is ignored when -f is used.

GODOT="/Applications/Godot.app/Contents/MacOS/godot"
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

if [ ! -x "$GODOT" ]; then
    echo "Godot not found at $GODOT" >&2
    exit 1
fi

FILTER=""
SINGLE_FILE=""
FAILING_ONLY=0
NO_COLOR=0

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--file)
            SINGLE_FILE="$2"
            shift 2
            ;;
        --failing-only)
            FAILING_ONLY=1
            shift
            ;;
        --no-color)
            NO_COLOR=1
            shift
            ;;
        unit|scene|integration|scenario)
            FILTER="$1"
            shift
            ;;
        -h|--help)
            sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            echo "Run 'script/checks/gut_tests --help' for usage." >&2
            exit 1
            ;;
    esac
done

# Strip ANSI escape codes when requested. Not needed when the caller greps
# with --failing-only unless they also want clean output.
strip_ansi() {
    sed 's/\x1b\[[0-9;]*m//g'
}

# Best-effort "failing only" filter. GUT emits failing tests as indented
# "- test_foo" lines under a "Failing tests:" section. This regex is
# conservative — on doubt it keeps more than less, because swallowing
# information is the original bug we are fixing.
failing_filter() {
    awk '
        /^\s*Failing tests:/        { in_fail=1; print; next }
        /^\s*Passing tests:/        { in_fail=0 }
        /^\s*Tests finished/        { in_fail=0 }
        /^\s*- test_/               { print; next }
        /FAILED|Failed:|Error:/     { print; next }
        in_fail                     { print }
    '
}

# Concise failure summary: extracts "file:line  test_name" from GUT's
# Run Summary section. Parses the format:
#   res://tests/path/file.gd
#   - test_name
#       [Failed]: message
#             at line 42
# and emits:
#   tests/path/file.gd:42  test_name
failure_summary() {
    # Strip ANSI first so regexes don't need to handle escape codes
    strip_ansi | awk '
        /^= Run Summary/ { in_summary=1; next }
        /^Totals/        { in_summary=0 }
        !in_summary      { next }
        /^res:\/\// {
            sub(/^res:\/\//, "")
            current_file=$0
            next
        }
        /^- test_/ {
            current_test=$0
            sub(/^- /, "", current_test)
            next
        }
        /at line [0-9]+/ {
            match($0, /at line [0-9]+/)
            line=substr($0, RSTART+8, RLENGTH-8)
            if (current_file != "" && current_test != "") {
                printf "  %s:%s  %s\n", current_file, line, current_test
                current_test=""
            }
        }
    '
}

# Run Godot and emit output with the requested filters applied.
# Always prints the full output on failure unless --failing-only is set.
present_output() {
    local output="$1"
    if [ "$NO_COLOR" = "1" ]; then
        output=$(printf '%s' "$output" | strip_ansi)
    fi
    if [ "$FAILING_ONLY" = "1" ]; then
        printf '%s' "$output" | failing_filter
    else
        printf '%s\n' "$output"
    fi
}

run_tests_dirs() {
    # Run one Godot invocation over multiple test dirs. Passing each dir as
    # a separate -gdir flag avoids paying ~0.7s of Godot boot per suite.
    local label="$1"
    shift
    local args=()
    local dir
    for dir in "$@"; do
        [ -d "$PROJECT_ROOT/$dir" ] || continue
        ls "$PROJECT_ROOT/$dir"/test_*.gd >/dev/null 2>&1 || continue
        args+=("-gdir=res://$dir")
    done
    if [ ${#args[@]} -eq 0 ]; then return 0; fi

    local OUTPUT
    OUTPUT=$("$GODOT" --headless --path "$PROJECT_ROOT" \
        -s addons/gut/gut_cmdln.gd "${args[@]}" -gexit 2>&1)

    if printf '%s' "$OUTPUT" | grep -q "All tests passed"; then
        return 0
    fi

    echo ""
    echo "===== FAIL: $label tests ====="
    present_output "$OUTPUT"
    echo ""
    echo "Failing tests:"
    printf '%s' "$OUTPUT" | failure_summary
    return 1
}

run_tests_file() {
    local file="$1"

    # Normalize: strip leading ./ or res:// if present so -gtest gets a clean path
    file="${file#./}"
    file="${file#res://}"

    if [ ! -f "$PROJECT_ROOT/$file" ]; then
        echo "Test file not found: $file" >&2
        return 1
    fi

    local OUTPUT
    OUTPUT=$("$GODOT" --headless --path "$PROJECT_ROOT" \
        -s addons/gut/gut_cmdln.gd -gtest="res://$file" -gexit 2>&1)

    if printf '%s' "$OUTPUT" | grep -q "All tests passed"; then
        # Still show the output in single-file mode — the user asked for
        # this specific file and probably wants to see what ran.
        present_output "$OUTPUT"
        return 0
    fi

    echo ""
    echo "===== FAIL: $file ====="
    present_output "$OUTPUT"
    echo ""
    echo "Failing tests:"
    printf '%s' "$OUTPUT" | failure_summary
    return 1
}

FAILED=0

if [ -n "$SINGLE_FILE" ]; then
    run_tests_file "$SINGLE_FILE" || FAILED=$((FAILED + 1))
else
    DIRS=()
    LABEL=""
    case "$FILTER" in
        unit)        DIRS=(tests/unit);        LABEL="Unit" ;;
        scene)       DIRS=(tests/scene);       LABEL="Scene" ;;
        integration) DIRS=(tests/integration); LABEL="Integration" ;;
        scenario)    DIRS=(tests/scenario);    LABEL="Scenario" ;;
        "")          DIRS=(tests/unit tests/scene tests/integration tests/scenario); LABEL="All" ;;
    esac
    run_tests_dirs "$LABEL" "${DIRS[@]}" || FAILED=$((FAILED + 1))
fi

if [ $FAILED -gt 0 ]; then
    exit 1
fi
exit 0
