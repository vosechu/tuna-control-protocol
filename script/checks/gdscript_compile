#!/bin/bash
# Verifies all GDScript files compile without parse errors.
# Godot --check-only isn't available, so we run --headless --import
# and check for "Parse Error" or "Failed to load script" in output.

GODOT="/Applications/Godot.app/Contents/MacOS/godot"
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

if [ ! -x "$GODOT" ]; then
    echo "Godot not found at $GODOT" >&2
    exit 1
fi

OUTPUT=$("$GODOT" --headless --path "$PROJECT_ROOT" --import 2>&1)

# Strip ANSI color codes and boot-progress noise. Keep everything else so
# we surface anything Godot prints — not just patterns we pre-guess at.
CLEANED=$(printf '%s\n' "$OUTPUT" \
    | sed 's/\x1b\[[0-9;]*m//g' \
    | grep -vE '^\[[[:space:]]+[0-9]+%[[:space:]]+\]' \
    | grep -vE '^\[[[:space:]]*DONE[[:space:]]*\]' \
    | grep -vE '^Godot Engine v' \
    | grep -vE '^[[:space:]]*$')

# Print everything that survived the noise filter. If Godot emits a
# warning we didn't anticipate, we'll see it here.
if [ -n "$CLEANED" ]; then
    printf '%s\n' "$CLEANED"
fi

# Fail only on genuine compile errors. Warnings pass the check but are
# visible in output above.
if printf '%s\n' "$CLEANED" | grep -qiE "Parse Error|Failed to load script|Cannot load source code|SCRIPT ERROR"; then
    exit 1
fi

exit 0
